# Google C# Style Guide (.editorconfig)
# https://google.github.io/styleguide/csharp-style.html

root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.cs]
# 1.1 PascalCase for Class, Method, Property, Constant, Enum, Event, Namespace
dotnet_naming_rule.pascal_case_rule.severity = error
dotnet_naming_rule.pascal_case_rule.symbols = pascal_case_symbols
dotnet_naming_rule.pascal_case_rule.style = pascal_case_style

dotnet_naming_symbols.pascal_case_symbols.applicable_kinds = class, struct, interface, enum, method, property, event, namespace, constant
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

# 1.2 camelCase for local variables and parameters
dotnet_naming_rule.camel_case_rule.severity = error
dotnet_naming_rule.camel_case_rule.symbols = camel_case_symbols
dotnet_naming_rule.camel_case_rule.style = camel_case_style

dotnet_naming_symbols.camel_case_symbols.applicable_kinds = parameter, local
dotnet_naming_style.camel_case_style.capitalization = camel_case

# 2.1 & 2.2 Private and static fields prefixed with underscore
dotnet_naming_rule.private_members_with_underscore.severity = error
dotnet_naming_rule.private_members_with_underscore.symbols = private_fields
dotnet_naming_rule.private_members_with_underscore.style = prefix_underscore

dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, protected, internal, private_protected, protected_internal
dotnet_naming_style.prefix_underscore.capitalization = camel_case
dotnet_naming_style.prefix_underscore.required_prefix = _

# Other style rules
csharp_style_expression_bodied_methods = true:suggestion
csharp_style_expression_bodied_constructors = true:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# StyleCop SA1633: File header
dotnet_diagnostic.SA1633.severity = none
# StyleCop SA1200: Using directives should be inside namespace
dotnet_diagnostic.SA1200.severity = none
# StyleCop SA1101: Prefix local calls with this
dotnet_diagnostic.SA1101.severity = none
# StyleCop SA1600: Elements should be documented
dotnet_diagnostic.SA1600.severity = none

# Default severity for analyzer diagnostics with category 'StyleCop.CSharp.LayoutRules'
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.LayoutRules.severity = none

# Default severity for analyzer diagnostics with category 'StyleCop.CSharp.NamingRules'
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.NamingRules.severity = none

# Default severity for all analyzer diagnostics
dotnet_analyzer_diagnostic.severity = none

# CA1305: Specify IFormatProvider
dotnet_diagnostic.CA1305.severity = silent

# CA1805: Do not initialize unnecessarily
dotnet_diagnostic.CA1805.severity = none

# CA1848: Use the LoggerMessage delegates
dotnet_diagnostic.CA1848.severity = silent

# CA1873: Avoid potentially expensive logging
dotnet_diagnostic.CA1873.severity = silent

# CA2007: Consider calling ConfigureAwait on the awaited task
dotnet_diagnostic.CA2007.severity = none

[src/Auth.Api/Migrations/*.cs]
dotnet_analyzer_diagnostic.severity = none
