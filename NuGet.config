<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Single pinned feed: hermetic, reproducible restore with no dependency-confusion
       risk from injected feeds. NuGet Audit checks this feed during restore
       (see Directory.Build.props). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
